# Copy to .env.local and fill in. NEVER commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Campus Doodle runs as a separate persistent Node/WebSocket service.
# Production: set this to its public HTTPS URL.
CAMPUS_DOODLE_URL=http://localhost:3101
# Generate a different random value for this secret and configure the same value in Vercel and Render.
CAMPUS_DOODLE_AUTH_SECRET=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# PayMongo server-only keys. Use matching test credentials in development
# and matching live credentials in production (including the webhook secret).
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
